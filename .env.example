# =============================================================================
# REQUIRED IN PRODUCTION (server fails to start without these)
# =============================================================================
# Contract ID of the milestone escrow smart contract (Soroban C... address).
# Source of truth: escrow-contract's deployments/testnet.json (contract_id).
CONTRACT_ID=CARZQMYKDGA4TTIE2XBDJ42EX27VYLLJGGG4WGUIXXWIVHPDTX3UCLJA

# Optional: escrow factory contract (C... address). When set, the indexer
# watches it and registers every escrow contract it creates (#660). Copy the
# factory id from the same escrow-contract deployments/testnet.json file when a
# factory deployment is published there; leave unset until then.
# FACTORY_CONTRACT_ID=C...

# Allowed CORS origins (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:3000,https://escrow.example.com

# Client API key(s) (comma-separated list, or single API_KEY)
API_KEYS=your-client-api-key-placeholder
# API_KEY=your-client-api-key-placeholder

# Admin API key(s) for indexer & admin endpoints (comma-separated list, or single ADMIN_API_KEY)
ADMIN_API_KEYS=your-admin-api-key-placeholder
# ADMIN_API_KEY=your-admin-api-key-placeholder

# Soroban RPC configuration (required in production; defaults to testnet in dev)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Optional Sentry-compatible error reporting (#895). Unset = disabled, no
# network calls. When set, unhandled errors, 500s and repeated poller failures
# are reported with the request id and GIT_SHA release tag; request bodies,
# x-api-key / x-admin-key headers and webhook URL query strings are scrubbed.
# SENTRY_DSN=https://public@errors.example.com/1

# Build SHA injected into the image at build time; returned by /health so
# deploys can verify the running version (#894). Set by the deploy workflow.
# GIT_SHA=6d06868b1a2b3c4d5e6f708192a3b4c5d6e7f809
# Maximum accepted JSON request body size (#1005). Passed to express.json();
# oversized bodies get a 413 JSON error response.
JSON_BODY_LIMIT=64kb
# Graceful shutdown: ms to wait for in-flight work before forcing exit. Default 10000.
# SHUTDOWN_TIMEOUT_MS=10000
# GET /ready fails when the last successful poll is older than this (ms).
# Default 3 x POLL_INTERVAL_MAX_MS.
# READY_MAX_POLL_AGE_MS=360000

# Database storage path for SQLite indexer database
DB_PATH=./data/indexer.db

# Source account (G... address) for read-only contract simulations. Optional:
# simulation never checks the sequence number, so it defaults to the all-zero
# account (#616).
# SIMULATION_SOURCE=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF

# Fallback source for the whitelist update transaction when no adminAddress is
# sent (G... address)
DEPLOYER_ADDRESS=GAODBHVR63Z56MVQRBEJSYM2H5423LJ4WAPUUBOFG4JYY72S6ROKVZRX

# RPC timeout in milliseconds
RPC_TIMEOUT_MS=10000

# Unsigned transactions returned by build-tx / partial-release /
# claim-auto-release (#677). Time bound in seconds, clamped to 120–300.
# Cached XDRs are only reused while at least UNSIGNED_TX_MIN_REMAINING_S
# of that window remains; otherwise a fresh XDR is built.
# UNSIGNED_TX_TIMEOUT_S=180
# UNSIGNED_TX_MIN_REMAINING_S=20

# Transaction inclusion fee (#681), applied to every transaction the API builds.
# fixed (default): INCLUSION_FEE_STROOPS, or the SDK BASE_FEE (100) when unset.
# feeStats: getFeeStats() sorobanInclusionFee.p90, cached for
# INCLUSION_FEE_CACHE_TTL_S, floored at INCLUSION_FEE_STROOPS and capped at
# MAX_INCLUSION_FEE_STROOPS. Falls back to the fixed fee if fee stats fail.
# INCLUSION_FEE_STRATEGY=fixed
# INCLUSION_FEE_STROOPS=100
# MAX_INCLUSION_FEE_STROOPS=100000
# INCLUSION_FEE_CACHE_TTL_S=15

# GET /api/jobs/:contractId job state cache (#679). Entries are also dropped as
# soon as the indexer stores a new event for the contract. 0 disables caching.
# JOB_STATE_CACHE_TTL_S=5

# =============================================================================
# GLOBAL RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_MAX_STRICT=10

# =============================================================================
# PER-ROUTE RATE LIMITS
# =============================================================================
BY_WALLET_RATE_LIMIT_MAX=30
JOB_CONTRACT_RATE_WINDOW_MS=60000
JOB_CONTRACT_RATE_MAX=30
BUILD_TX_RATE_WINDOW_MS=60000
BUILD_TX_RATE_MAX=20
CREATE_JOB_DRAFT_RATE_WINDOW_MS=60000
CREATE_JOB_DRAFT_RATE_MAX=5
SUBMIT_RATE_WINDOW_MS=60000
SUBMIT_RATE_MAX=5
TIME_REMAINING_RATE_WINDOW_MS=60000
TIME_REMAINING_RATE_MAX=60
PARTIAL_RELEASE_RATE_WINDOW_MS=60000
PARTIAL_RELEASE_RATE_MAX=10
CLAIM_AUTO_RELEASE_RATE_WINDOW_MS=60000
CLAIM_AUTO_RELEASE_RATE_MAX=10
JOB_WHITELIST_RATE_WINDOW_MS=60000
JOB_WHITELIST_RATE_MAX=20
JOB_WHITELIST_UPDATE_RATE_WINDOW_MS=60000
JOB_WHITELIST_UPDATE_RATE_MAX=10
PARTIAL_PAYMENT_ALLOCATOR_RATE_WINDOW_MS=60000
PARTIAL_PAYMENT_ALLOCATOR_RATE_MAX=50
AUDIT_RATE_WINDOW_MS=60000
AUDIT_RATE_MAX=30
AUDIT_LEDGER_RATE_WINDOW_MS=60000
AUDIT_LEDGER_RATE_MAX=30
# Dedicated budget for POST /api/webhooks/subscribe and /api/webhooks/unsubscribe (#604).
# Applies per client, per RATE_LIMIT_WINDOW_MS. Default 30.
WEBHOOK_RATE_LIMIT_MAX=30

# Number of reverse-proxy hops to trust for X-Forwarded-For (#600).
# Defaults to 1 in production (nginx) and 0 (off) elsewhere. Never set this
# higher than the real number of proxies, or clients can spoof their IP.
# TRUST_PROXY_HOPS=1

# =============================================================================
# ROUTE RESPONSE CACHE TTL (SECONDS)
# =============================================================================
WHITELIST_CACHE_TTL_S=60
CLAIM_AUTO_RELEASE_CACHE_TTL_S=60
SUBMIT_CACHE_TTL_S=30
BUILD_TX_CACHE_TTL_S=30
TIME_REMAINING_CACHE_TTL_S=15
PARTIAL_RELEASE_CACHE_TTL_S=30
FEE_PREVIEW_CACHE_TTL_S=30
JOBS_BY_WALLET_CACHE_TTL_S=60

# =============================================================================
# INDEXER POLLER & THROTTLING
# =============================================================================
POLL_INTERVAL_MS=5000
POLL_INTERVAL_MAX_MS=60000
POLLER_MIN_INTERVAL_MS=1000
POLLER_MAX_INTERVAL_MS=30000
POLLER_IDLE_MULTIPLIER=1.5
POLLER_IDLE_THRESHOLD=5
POLLER_LOAD_DECREASE_FACTOR=0.5
POLLER_FAILURE_THRESHOLD=5
POLLER_STALL_THRESHOLD_MS=120000
POLL_DIAGNOSTIC_LOG_MIN_INTERVAL_MS=30000
# Most RPC pages one poll cycle follows before yielding (#608)
POLLER_MAX_PAGES_PER_POLL=20
RECONCILE_INTERVAL_MS=3600000
# /ready probes: max age of a successful poll, max ledger lag observed by that
# poll (#893). Defaults: 3x POLL_INTERVAL_MAX_MS and 120 ledgers (~10 min).
# READY_MAX_POLL_AGE_MS=360000
# READY_MAX_LEDGER_LAG=120

# Retention window for reconciliation_results rows (days); default 14.
# Only the latest result per contract is consumed by the admin status endpoint;
# older rows serve as audit history. Increase to retain more history.
# RECONCILIATION_RETENTION_DAYS=14

# =============================================================================
# INDEXER RUNNER / METRICS / VACUUM / POOL
# =============================================================================
INDEXER_RUNNER_POLL_INTERVAL_MS=5000
INDEXER_RUNNER_MIN_POLL_INTERVAL_MS=1000
INDEXER_RUNNER_MAX_POLL_INTERVAL_MS=30000
INDEXER_RUNNER_IDLE_MULTIPLIER=1.5
INDEXER_RUNNER_IDLE_THRESHOLD_CYCLES=5
INDEXER_RUNNER_LOAD_DECREASE_FACTOR=0.5
INDEXER_RUNNER_FAILURE_THRESHOLD=5
INDEXER_RUNNER_STALL_THRESHOLD_MS=120000

INDEXER_METRICS_POLL_INTERVAL_MS=10000
INDEXER_METRICS_MIN_POLL_INTERVAL_MS=2000
INDEXER_METRICS_MAX_POLL_INTERVAL_MS=60000
INDEXER_METRICS_IDLE_MULTIPLIER=2.0
INDEXER_METRICS_IDLE_THRESHOLD_CYCLES=3

VACUUM_POLL_INTERVAL_MS=3600000
VACUUM_MIN_POLL_INTERVAL_MS=300000
VACUUM_MAX_POLL_INTERVAL_MS=86400000

# Health alert thresholds (consecutive failures / ms without progress).
# All default to 3 failures and the stall values shown below.
# VACUUM_FAILURE_THRESHOLD=3
# VACUUM_STALL_THRESHOLD_MS=7200000
# INDEXER_METRICS_FAILURE_THRESHOLD=3
# INDEXER_METRICS_STALL_THRESHOLD_MS=120000
# SQLITE_SCHEMA_MANAGER_FAILURE_THRESHOLD=3
# SQLITE_SCHEMA_MANAGER_STALL_THRESHOLD_MS=120000
# LEDGER_RANGE_FAILURE_THRESHOLD=3
# LEDGER_RANGE_STALL_THRESHOLD_MS=120000

# Failover recovery alert thresholds
FAILOVER_RECOVERY_FAILURE_THRESHOLD=3
FAILOVER_RECOVERY_STALL_THRESHOLD_MS=120000
INDEXER_FAILOVER_RECOVERY_FAILURE_THRESHOLD=3
INDEXER_FAILOVER_RECOVERY_STALL_THRESHOLD_MS=120000
# Legacy aliases, read only when the names above are unset.
# FAILOVER_FAILURE_THRESHOLD=3
# FAILOVER_STALL_THRESHOLD_MS=120000

# Failover recovery adaptive polling. The first set name in each group wins;
# the INDEXER_-prefixed and shorter names are aliases.
# Base interval falls back to POLL_INTERVAL_MS when none of its names is set.
# FAILOVER_RECOVERY_BASE_POLL_INTERVAL_MS=15000
# FAILOVER_RECOVERY_POLL_INTERVAL_MS=15000
# INDEXER_FAILOVER_RECOVERY_POLL_INTERVAL_MS=15000
# FAILOVER_RECOVERY_MIN_POLL_INTERVAL_MS=5000
# FAILOVER_RECOVERY_MIN_INTERVAL_MS=5000
# INDEXER_FAILOVER_RECOVERY_MIN_POLL_INTERVAL_MS=5000
# FAILOVER_RECOVERY_MAX_POLL_INTERVAL_MS=60000
# FAILOVER_RECOVERY_MAX_INTERVAL_MS=60000
# INDEXER_FAILOVER_RECOVERY_MAX_POLL_INTERVAL_MS=60000
# FAILOVER_RECOVERY_IDLE_MULTIPLIER=2
# INDEXER_FAILOVER_RECOVERY_IDLE_MULTIPLIER=2
# FAILOVER_RECOVERY_IDLE_THRESHOLD_CYCLES=3
# FAILOVER_RECOVERY_IDLE_THRESHOLD=3
# INDEXER_FAILOVER_RECOVERY_IDLE_THRESHOLD_CYCLES=3
# FAILOVER_RECOVERY_LOAD_DECREASE_FACTOR=0.5
# INDEXER_FAILOVER_RECOVERY_LOAD_DECREASE_FACTOR=0.5

# RPC exponential backoff retry (#249)
INDEXER_RPC_MAX_RETRIES=5
INDEXER_RPC_INITIAL_BACKOFF_MS=1000
INDEXER_RPC_BACKOFF_MULTIPLIER=2
INDEXER_RPC_MAX_BACKOFF_MS=30000

# =============================================================================
# HISTORICAL LEDGER IMPORT & WEBHOOKS
# =============================================================================
# Optional one-off historical import. When set, the inclusive window is
# imported once at poller startup, recorded in indexer_state (key
# historical_backfill:<start>-<end>) and skipped on later restarts; live
# polling starts right after it (#675). Ad-hoc ranges go through
# POST /api/admin/backfill (#703). Historical imports never move the live
# ledger pointer.
# LEDGER_RANGE_START=1
# LEDGER_RANGE_END=10000
MAX_LEDGERS_PER_IMPORT=1000
# Events requested per RPC page during a ledger-range import. Default 100.
# LEDGER_RANGE_PAGE_SIZE=100

# Webhook delivery
WEBHOOK_DELIVERY_PAGE_SIZE=500
# Failed deliveries retry with exponential backoff from this base delay, up to
# the attempt and age limits, then move to the dead-letter list (#611)
WEBHOOK_RETRY_BASE_DELAY_MS=60000
WEBHOOK_MAX_DELIVERY_ATTEMPTS=25
WEBHOOK_RETRY_MAX_AGE_DAYS=7
# Per-attempt timeout in ms for webhook POSTs (#606). A receiver that accepts the
# connection but never answers fails the attempt instead of stalling the
# delivery loop, and delivery moves on to the next subscriber.
WEBHOOK_TIMEOUT_MS=5000
# Consecutive failed deliveries after which a subscription is auto-disabled
# (#701). Subscribing again re-enables it. Default 50.
WEBHOOK_DISABLE_AFTER=50

# Token metadata (decimals/symbol/name) cache TTL in seconds; minimum 60 (#699).
TOKEN_METADATA_CACHE_TTL_SECONDS=86400
# Test-only: let suites deliver to a local loopback receiver. Ignored unless
# NODE_ENV=test; production always rejects private/internal targets (#605).
# WEBHOOK_ALLOW_PRIVATE_HOSTS=1

# Indexer RPC node failover (#531)
# Comma-separated Soroban RPC nodes for the indexer. Defaults to SOROBAN_RPC_URL.
# With more than one node, poll outcomes are tracked per node and the indexer
# switches to the healthiest node when the active one is marked unhealthy.
# SOROBAN_RPC_URLS=https://rpc-a.example.org,https://rpc-b.example.org

# SQLite maintenance (wal_checkpoint + optimize) interval in ms; default 6h.
# DB_MAINTENANCE_INTERVAL_MS=21600000
# The first run is one interval (plus jitter) after startup, never at boot.
# When set, maintenance also prunes events older than this many days and
# reclaims space with stepped PRAGMA incremental_vacuum. Unset keeps every event.
# EVENT_RETENTION_DAYS=90
# Maintenance deletes delivered webhook_deliveries rows older than this many
# days (default 7); dead rows are pruned after 90 days, failed rows never (#940).
# WEBHOOK_DELIVERY_RETENTION_DAYS=7

# Host-side indexer DB backups to S3 (deploy/backup.sh, see deploy/BACKUP.md).
# Read by the backup script on the host, not by the backend process.
# BACKUP_S3_BUCKET=
