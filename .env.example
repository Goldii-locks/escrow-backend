# =============================================================================
# REQUIRED IN PRODUCTION (server fails to start without these)
# =============================================================================
# Contract ID of the milestone escrow smart contract (Soroban C... address)
CONTRACT_ID=CDD5WKK3WT3QVKXMXTJNDIXE4T73FK6GGXDSD6UTJAH6YYZU52SQ4MUH

# Optional: escrow factory contract (C... address). When set, the indexer
# watches it and registers every escrow contract it creates (#660).
# FACTORY_CONTRACT_ID=C...

# Allowed CORS origins (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:3000,https://escrow.example.com

# Client API key(s) (comma-separated list, or single API_KEY)
API_KEYS=your-client-api-key-placeholder
# API_KEY=your-client-api-key-placeholder

# Admin API key(s) for indexer & admin endpoints (comma-separated list, or single ADMIN_API_KEY)
ADMIN_API_KEYS=your-admin-api-key-placeholder
# ADMIN_API_KEY=your-admin-api-key-placeholder

# Soroban RPC configuration (required in production; defaults to testnet in dev)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database storage path for SQLite indexer database
DB_PATH=./data/indexer.db

# Source account (G... address) for read-only contract simulations. Optional:
# simulation never checks the sequence number, so it defaults to the all-zero
# account (#616).
# SIMULATION_SOURCE=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF

# Fallback source for the whitelist update transaction when no adminAddress is
# sent (G... address)
DEPLOYER_ADDRESS=GAODBHVR63Z56MVQRBEJSYM2H5423LJ4WAPUUBOFG4JYY72S6ROKVZRX

# RPC timeout in milliseconds
RPC_TIMEOUT_MS=10000

# =============================================================================
# GLOBAL RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_MAX_STRICT=10

# =============================================================================
# PER-ROUTE RATE LIMITS
# =============================================================================
BY_WALLET_RATE_LIMIT_MAX=30
JOB_CONTRACT_RATE_WINDOW_MS=60000
JOB_CONTRACT_RATE_MAX=30
BUILD_TX_RATE_WINDOW_MS=60000
BUILD_TX_RATE_MAX=20
CREATE_JOB_DRAFT_RATE_WINDOW_MS=60000
CREATE_JOB_DRAFT_RATE_MAX=5
SUBMIT_RATE_WINDOW_MS=60000
SUBMIT_RATE_MAX=5
TIME_REMAINING_RATE_WINDOW_MS=60000
TIME_REMAINING_RATE_MAX=60
PARTIAL_RELEASE_RATE_WINDOW_MS=60000
PARTIAL_RELEASE_RATE_MAX=10
CLAIM_AUTO_RELEASE_RATE_WINDOW_MS=60000
CLAIM_AUTO_RELEASE_RATE_MAX=10
JOB_WHITELIST_RATE_WINDOW_MS=60000
JOB_WHITELIST_RATE_MAX=20
JOB_WHITELIST_UPDATE_RATE_WINDOW_MS=60000
JOB_WHITELIST_UPDATE_RATE_MAX=10
PARTIAL_PAYMENT_ALLOCATOR_RATE_WINDOW_MS=60000
PARTIAL_PAYMENT_ALLOCATOR_RATE_MAX=50
CONVERSION_RATE_WINDOW_MS=60000
CONVERSION_RATE_MAX=30
TAX_ESTIMATOR_RATE_WINDOW_MS=60000
TAX_ESTIMATOR_RATE_MAX=30
REFUND_RATIO_RATE_WINDOW_MS=60000
REFUND_RATIO_RATE_MAX=20
AUDIT_RATE_WINDOW_MS=60000
AUDIT_RATE_MAX=30
AUDIT_LEDGER_RATE_WINDOW_MS=60000
AUDIT_LEDGER_RATE_MAX=30
FINANCIAL_REPORT_EXPORTER_RATE_WINDOW_MS=60000
FINANCIAL_REPORT_EXPORTER_RATE_MAX=20

# =============================================================================
# ROUTE RESPONSE CACHE TTL (SECONDS)
# =============================================================================
WHITELIST_CACHE_TTL_S=60
CLAIM_AUTO_RELEASE_CACHE_TTL_S=60
SUBMIT_CACHE_TTL_S=30
BUILD_TX_CACHE_TTL_S=30
TIME_REMAINING_CACHE_TTL_S=15
PARTIAL_RELEASE_CACHE_TTL_S=30
FEE_PREVIEW_CACHE_TTL_S=30
JOBS_BY_WALLET_CACHE_TTL_S=60

# =============================================================================
# INDEXER POLLER & THROTTLING
# =============================================================================
POLL_INTERVAL_MS=5000
POLL_INTERVAL_MAX_MS=60000
POLLER_MIN_INTERVAL_MS=1000
POLLER_MAX_INTERVAL_MS=30000
POLLER_IDLE_MULTIPLIER=1.5
POLLER_IDLE_THRESHOLD=5
POLLER_LOAD_DECREASE_FACTOR=0.5
POLLER_FAILURE_THRESHOLD=5
POLLER_STALL_THRESHOLD_MS=120000
POLL_DIAGNOSTIC_LOG_MIN_INTERVAL_MS=30000
# Most RPC pages one poll cycle follows before yielding (#608)
POLLER_MAX_PAGES_PER_POLL=20
RECONCILE_INTERVAL_MS=3600000

# =============================================================================
# INDEXER RUNNER / METRICS / VACUUM / POOL
# =============================================================================
INDEXER_RUNNER_POLL_INTERVAL_MS=5000
INDEXER_RUNNER_MIN_POLL_INTERVAL_MS=1000
INDEXER_RUNNER_MAX_POLL_INTERVAL_MS=30000
INDEXER_RUNNER_IDLE_MULTIPLIER=1.5
INDEXER_RUNNER_IDLE_THRESHOLD_CYCLES=5
INDEXER_RUNNER_LOAD_DECREASE_FACTOR=0.5
INDEXER_RUNNER_FAILURE_THRESHOLD=5
INDEXER_RUNNER_STALL_THRESHOLD_MS=120000

INDEXER_METRICS_POLL_INTERVAL_MS=10000
INDEXER_METRICS_MIN_POLL_INTERVAL_MS=2000
INDEXER_METRICS_MAX_POLL_INTERVAL_MS=60000
INDEXER_METRICS_IDLE_MULTIPLIER=2.0
INDEXER_METRICS_IDLE_THRESHOLD_CYCLES=3

WRITER_POOL_POLL_INTERVAL_MS=5000
WRITER_POOL_MIN_POLL_INTERVAL_MS=1000
WRITER_POOL_MAX_POLL_INTERVAL_MS=30000

VACUUM_POLL_INTERVAL_MS=3600000
VACUUM_MIN_POLL_INTERVAL_MS=300000
VACUUM_MAX_POLL_INTERVAL_MS=86400000

# Failover recovery alert thresholds
FAILOVER_RECOVERY_FAILURE_THRESHOLD=3
FAILOVER_RECOVERY_STALL_THRESHOLD_MS=120000
INDEXER_FAILOVER_RECOVERY_FAILURE_THRESHOLD=3
INDEXER_FAILOVER_RECOVERY_STALL_THRESHOLD_MS=120000

# RPC exponential backoff retry (#249)
INDEXER_RPC_MAX_RETRIES=5
INDEXER_RPC_INITIAL_BACKOFF_MS=1000
INDEXER_RPC_BACKOFF_MULTIPLIER=2
INDEXER_RPC_MAX_BACKOFF_MS=30000

# =============================================================================
# HISTORICAL LEDGER IMPORT & WEBHOOKS
# =============================================================================
# Default inclusive range for the historical import helpers. Backfills run
# through POST /api/admin/backfill (#703); live polling is not affected.
LEDGER_RANGE_START=1
LEDGER_RANGE_END=10000
MAX_LEDGERS_PER_IMPORT=1000

# Webhook delivery
WEBHOOK_DELIVERY_PAGE_SIZE=500
# Failed deliveries retry with exponential backoff from this base delay, up to
# the attempt and age limits, then move to the dead-letter list (#611)
WEBHOOK_RETRY_BASE_DELAY_MS=60000
WEBHOOK_MAX_DELIVERY_ATTEMPTS=25
WEBHOOK_RETRY_MAX_AGE_DAYS=7
EMAIL_WEBHOOK_SECRET=replace-me-with-a-long-random-secret
EMAIL_SENDER_TIMEOUT_MS=5000

# webhook_dispatcher – HMAC-SHA256 signing of outgoing webhooks (#202)
# Min 32 characters. When unset, webhooks are sent unsigned.
# WEBHOOK_SIGNING_SECRET=replace-me-with-a-long-random-secret

# push_notification_service – HMAC-SHA256 signing of push messages (#203)
# Required (min 32 characters); unsigned push messages are never published.
# PUSH_NOTIFICATION_SECRET=replace-me-with-a-long-random-secret
