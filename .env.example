# Soroban RPC configuration (optional – defaults to Testnet)
# Change these to target Futurenet, a local sandbox, or Mainnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_MAX_STRICT=10

# Ledger range tracker – optional historical import (#299, #298, #297)
# Start/end are inclusive. When unset, live polling continues from last_indexed+1.
# Historical imports do not advance the live ledger pointer.
# LEDGER_RANGE_START=1
# LEDGER_RANGE_END=10000
# LEDGER_RANGE_PAGE_SIZE=100
# Consecutive tracker failures before a warning alert is emitted (default: 3)
# LEDGER_RANGE_FAILURE_THRESHOLD=3
# Stall window in ms since last successful tracker operation (default: 120000)
# LEDGER_RANGE_STALL_THRESHOLD_MS=120000
