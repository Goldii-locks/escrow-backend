PORT=3001
CONTRACT_ID=CDD5WKK3WT3QVKXMXTJNDIXE4T73FK6GGXDSD6UTJAH6YYZU52SQ4MUH
DEPLOYER_ADDRESS=GAODBHVR63Z56MVQRBEJSYM2H5423LJ4WAPUUBOFG4JYY72S6ROKVZRX

# Soroban RPC configuration (optional – defaults to Testnet)
# Change these to target Futurenet, a local sandbox, or Mainnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_MAX_STRICT=10

# Ledger range tracker – optional historical import (#299, #298, #297)
# Start/end are inclusive. When unset, live polling continues from last_indexed+1.
# Historical imports do not advance the live ledger pointer.
# The window is imported once at poller startup, recorded in indexer_state
# (key historical_backfill:<start>-<end>), and skipped on later restarts;
# live polling starts right after it (#675).
# LEDGER_RANGE_START=1
# LEDGER_RANGE_END=10000
# LEDGER_RANGE_PAGE_SIZE=100
# Consecutive tracker failures before a warning alert is emitted (default: 3)
# LEDGER_RANGE_FAILURE_THRESHOLD=3
# Stall window in ms since last successful tracker operation (default: 120000)
# LEDGER_RANGE_STALL_THRESHOLD_MS=120000

# Unsigned transactions returned by build-tx / partial-release /
# claim-auto-release (#677). Time bound in seconds, clamped to 120–300.
# Cached XDRs are only reused while at least UNSIGNED_TX_MIN_REMAINING_S
# of that window remains; otherwise a fresh XDR is built.
# UNSIGNED_TX_TIMEOUT_S=180
# UNSIGNED_TX_MIN_REMAINING_S=20

# Indexer RPC exponential backoff retry (#249)
# Retry transient RPC failures (timeouts, connection resets, rate limits, 5xx)
# with a doubling backoff up to the configured max. Resets on success.
INDEXER_RPC_MAX_RETRIES=5
INDEXER_RPC_INITIAL_BACKOFF_MS=1000
INDEXER_RPC_BACKOFF_MULTIPLIER=2
INDEXER_RPC_MAX_BACKOFF_MS=30000

# email_sender_service – outbound webhook signing + call timeouts (#522, #523)
# EMAIL_WEBHOOK_SECRET=replace-me-with-a-long-random-secret
# EMAIL_SENDER_TIMEOUT_MS=5000
