# Backend defaults for docker-compose.dev.yml (#963). Local development only:
# nothing here is a real secret. .env.dev (written by the deploy service)
# overrides these, and docker-compose.dev.yml's `environment` overrides both.

# Until the deploy service has run, index the standalone network's native XLM
# token contract (it always has this id there) so the poller has something
# to poll and /ready can turn 200. It stays registered in data/indexer.db
# after a real CONTRACT_ID replaces it; delete the DB to drop it.
CONTRACT_ID=CDMLFMKMMD7MWZP3FKUBZPVHTUEDLSX4BYGYKH4GCESXYHS3IHQ4EIG4

ALLOWED_ORIGINS=http://localhost:3000
API_KEY=dev-api-key
ADMIN_API_KEY=dev-admin-key
LOG_LEVEL=info
POLL_INTERVAL_MS=5000
