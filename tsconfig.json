{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["jest"],
    "isolatedModules": true
  },
  "include": ["src/**/*", "__tests__/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "__tests__/ledger-range-tracker-improvements.test.ts"
  ],
  "ts-node": {
    "esm": true
  }
}
