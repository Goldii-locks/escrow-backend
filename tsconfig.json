{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["jest"],
    "isolatedModules": true,
    // test/e2e global setup/teardown run outside Jest's module mapping, so
    // they import siblings by their real `.ts` names.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*", "__tests__/**/*", "test/**/*", "jest.setup.ts"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    "esm": true
  }
}
